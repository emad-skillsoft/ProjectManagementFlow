@model AccountLoginViewModel
@inject IWebHostEnvironment HostEnvironment

@{
    ViewData["Title"] = T["Login_Title"].Value;
    // القشرة تبقى كما في المرجع: ترويسة وتذييل، بلا تنقّل ولا شريط جانبيّ.
    // يضبطها AccountController عبر LayoutBuilder.BuildForSignIn().
}

<section class="ds-auth-shell">
    <div class="ds-auth-card">
        <header class="mb-4">
            <h1>@(T["Login_Title"])</h1>
            <p>@(T["Login_Subtitle"])</p>
        </header>

        @* لا يُرسم الصندوق إلّا عند وجود خطأ فعليّ — وإلّا ظهر تنبيه فارغ. *@
        @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger ds-alert-accent" role="alert">
                <span aria-hidden="true">⚠</span>
                <div asp-validation-summary="ModelOnly" class="d-inline"></div>
            </div>
        }

        <form asp-action="Login" method="post" class="d-flex flex-column gap-3">
            <input type="hidden" asp-for="ReturnUrl" />

            <div>
                <label class="form-label fw-semibold" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" type="email" dir="ltr"
                       autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div>
                <label class="form-label fw-semibold" asp-for="Password"></label>
                <input class="form-control" asp-for="Password" type="password"
                       autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button class="btn btn-primary w-100" type="submit">@(T["Login_Submit"])</button>
        </form>

        @* بيانات الحسابات التجريبيّة للتطوير وحده — لا تُطبع في بيئة نشر. *@
        @if (HostEnvironment.IsDevelopment())
        {
            <p class="text-body-secondary small mt-3 mb-0" lang="en" dir="ltr">
                admin@example.com · user@example.com
            </p>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
