@model UserRolesViewModel

@{
    ViewData["Title"] = T["UserRoles_Title", Model.DisplayName].Value;
}

<section class="ds-permissions-page ds-page-narrow">
    <header class="ds-permissions-page__header">
        <h1>@ViewData["Title"]</h1>
    </header>
    <p class="text-muted" dir="ltr">@Model.Email</p>

    <partial name="_StatusMessage" />

    @if (Model.IsSelf)
    {
        <div class="alert alert-warning">@T["UserRoles_SelfWarning"]</div>
    }

    <form method="post" action="/Organization/Members/@Model.UserId/roles?unit=@Model.OrganizationId">
        @Html.AntiForgeryToken()
        <div class="list-group mb-3">
            @foreach (var role in Model.Roles)
            {
                <label class="list-group-item d-flex gap-3 align-items-start">
                    <input class="form-check-input mt-1" type="checkbox" name="SelectedRoleIds"
                           value="@role.Id" checked="@role.IsAssigned" disabled="@Model.IsSelf" />
                    <span>
                        <span class="fw-semibold">@role.Name</span>
                        <span class="d-block text-muted small">@role.Description</span>
                    </span>
                </label>
            }
        </div>

        @if (!Model.IsSelf)
        {
            <button type="submit" class="btn btn-primary">@T["UserRoles_Save"]</button>
        }
        <a class="btn btn-link" href="/Organization/Members?unit=@Model.OrganizationId">@T["Common_Back"]</a>
    </form>
</section>
