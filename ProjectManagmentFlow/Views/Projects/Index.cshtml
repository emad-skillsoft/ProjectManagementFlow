@model ProjectsIndexViewModel
@{
    ViewData["Title"] = T["Nav_Projects"].Value;
    var activeHref = ViewData["ProjectsActiveHref"] as string ?? "/Projects";
    var archivedHref = ViewData["ProjectsArchivedHref"] as string ?? "/Projects?tab=archived";
    var unitBadge = new UnitTypeBadgeViewModel
    {
        Label = T[$"OrgType_{Model.Unit.Type}"].Value,
        IsRoot = Model.HasUnit && Model.Unit.Depth == 0 && Model.Unit.Type == "organization"
    };
}

<section class="ds-permissions-page" data-project-list>
    @if (TempData["ProjectCreated"] is string created && !string.IsNullOrWhiteSpace(created))
    {
        <div class="ds-alert-accent ds-success-bg ds-success-border p-3 mb-3" role="status">
            <span aria-hidden="true">✓</span> <span>@created</span>
        </div>
    }
    @if (TempData["ProjectArchived"] is string archived && !string.IsNullOrWhiteSpace(archived))
    {
        <div class="ds-alert-accent ds-success-bg ds-success-border p-3 mb-3" role="status">
            <span aria-hidden="true">✓</span> <span>@archived</span>
        </div>
    }

    @if (!Model.HasUnit)
    {
        <header class="ds-permissions-page__header">
            <h1>@T["Nav_Projects"]</h1>
        </header>
        <div class="ds-empty-state">
            <h2>@T["Projects_Empty"]</h2>
            <p>@T["Projects_EmptyHint"]</p>
            <a class="btn btn-outline-secondary" href="/Structure">@T["Projects_ChangeUnit"]</a>
        </div>
    }
    else
    {
        <div class="ds-unit-context mb-3">
            <div class="ds-unit-context__identity">
                <small>@T["Projects_UnitLabel"]</small>
                <strong>@Model.Unit.Name</strong>
                <partial name="_UnitTypeBadge" model="unitBadge" />
                <a class="link-success fw-semibold text-decoration-none" href="/Structure">
                    @T["Projects_ChangeUnit"]
                </a>
            </div>

            <form method="get" action="/Projects" class="ms-auto" data-project-scope>
                <input type="hidden" name="unit" value="@Model.Unit.Id" />
                <input type="hidden" name="tab" value="@(Model.Scope == ProjectManagmentFlow.Services.Projects.ProjectScope.Archived ? "archived" : "active")" />
                @if (!string.IsNullOrWhiteSpace(Model.Status))
                {
                    <input type="hidden" name="status" value="@Model.Status" />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <input type="hidden" name="q" value="@Model.Search" />
                }
                <partial name="_UnitScopeSwitch" model="Model.ScopeSwitch" />
                <noscript>
                    <button class="btn btn-outline-secondary mt-2" type="submit">@T["Common_Save"]</button>
                </noscript>
            </form>
        </div>

        <header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <h1 class="fs-4 mb-0">@T["Nav_Projects"]</h1>
                <span class="visually-hidden">@T["Projects_Count", Model.Cards.Count]</span>
                <div class="ds-segmented" role="radiogroup" aria-label="@T["Nav_Projects"]">
                    <a class="ds-segmented-button"
                       role="radio" aria-checked="@(Model.Scope == ProjectManagmentFlow.Services.Projects.ProjectScope.Active ? "true" : "false")"
                       href="@activeHref">@T["Projects_TabActive"]</a>
                    <a class="ds-segmented-button"
                       role="radio" aria-checked="@(Model.Scope == ProjectManagmentFlow.Services.Projects.ProjectScope.Archived ? "true" : "false")"
                       href="@archivedHref">@T["Projects_TabArchived"]</a>
                </div>
            </div>

            @if (Model.CanCreate)
            {
                <a class="btn btn-primary" href="/Projects/Create?unit=@Model.Unit.Id">
                    @T["Projects_New"] <span aria-hidden="true">+</span>
                </a>
            }
        </header>

        <div class="row g-3 align-items-center mb-4">
            <div class="col-12 col-lg-3">
                <form method="get" action="/Projects"
                      class="ds-table-toolbar input-group flex-nowrap gap-0 border-0 bg-transparent p-0">
                    <input type="hidden" name="unit" value="@Model.Unit.Id" />
                    <input type="hidden" name="sub" value="@(Model.IncludeDescendants ? "true" : "false")" />
                    <input type="hidden" name="tab" value="@(Model.Scope == ProjectManagmentFlow.Services.Projects.ProjectScope.Archived ? "archived" : "active")" />
                    @if (!string.IsNullOrWhiteSpace(Model.Status))
                    {
                        <input type="hidden" name="status" value="@Model.Status" />
                    }
                    <label class="visually-hidden" for="project-search">@T["Projects_Search"]</label>
                    <input class="form-control" id="project-search" name="q" type="search"
                           value="@Model.Search" placeholder="@T["Projects_Search"]" />
                    <button class="btn btn-outline-secondary" type="submit" aria-label="@T["Projects_Search"]">
                        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="m20 20-3.5-3.5"></path>
                        </svg>
                    </button>
                </form>
            </div>

            <nav class="ds-filter-chips col-12 col-lg-auto" role="radiogroup" aria-label="@T["Projects_ColumnStatus"]">
                @foreach (var filter in Model.Filters)
                {
                    <a class="ds-filter-chip"
                       role="radio" aria-checked="@(filter.IsSelected ? "true" : "false")"
                       href="@filter.Href">
                        @filter.Label
                        <span class="badge ds-badge-neutral"><bdi class="ds-bidi-isolate" dir="ltr">@filter.Count</bdi></span>
                    </a>
                }
            </nav>

            <div class="col-12 col-lg-auto ms-lg-auto">
                <div class="ds-segmented ds-segmented--compact w-auto" role="radiogroup" aria-label="@T["Projects_ViewCards"]">
                    <button class="ds-segmented-button" type="button" role="radio" aria-checked="true"
                            data-project-view-button="cards">@T["Projects_ViewCards"]</button>
                    <button class="ds-segmented-button" type="button" role="radio" aria-checked="false"
                            data-project-view-button="table">@T["Projects_ViewTable"]</button>
                </div>
            </div>
        </div>

        @if (Model.Cards.Count == 0)
        {
            <div class="ds-empty-state">
                <h2>@T["Projects_Empty"]</h2>
                <p>@T["Projects_EmptyHint"]</p>
            </div>
        }
        else
        {
            <div class="ds-project-grid" data-project-view-panel="cards">
                @foreach (var project in Model.Cards)
                {
                    <partial name="_ProjectCard" model="project" />
                }
            </div>

            <div class="ds-file-table" role="table" aria-label="@T["Nav_Projects"]"
                 data-project-view-panel="table" hidden>
                <div class="ds-file-table__head" role="row">
                    <span role="columnheader">@T["Projects_ColumnProject"]</span>
                    <span role="columnheader">@T["Projects_ColumnStatus"]</span>
                    <span role="columnheader">@T["Projects_ColumnOwner"]</span>
                    <span role="columnheader">@T["Projects_ColumnProgress"]</span>
                </div>
                @foreach (var project in Model.Cards)
                {
                    <div class="ds-file-row" role="row">
                        <div class="ds-file-row__name" role="cell">
                            <div>
                                <a class="ds-file-row__title" href="@project.Href">@project.Name</a>
                                <bdi class="ds-file-row__meta ds-bidi-isolate" dir="ltr">@project.Code</bdi>
                            </div>
                        </div>
                        <div role="cell">
                            <span class="badge @project.StatusBadgeClass d-inline-flex align-items-center gap-1">
                                <span class="@project.StatusClass" aria-hidden="true"></span>@project.StatusLabel
                            </span>
                            <span class="ds-file-row__meta">@project.UnitName</span>
                        </div>
                        <div role="cell">
                            <span class="ds-file-row__title">@project.OwnerName</span>
                            <span class="ds-file-row__meta">@project.DueLabel</span>
                        </div>
                        <div role="cell">
                            <div class="ds-project-card__progress-label">
                                <bdi class="ds-bidi-isolate" dir="ltr">@project.ProgressLabel</bdi>
                                <bdi class="ds-bidi-isolate" dir="ltr">@project.Percent%</bdi>
                            </div>
                            <div class="ds-progress" role="progressbar" aria-label="@T["Projects_Progress"]"
                                 aria-valuenow="@project.Percent" aria-valuemin="0" aria-valuemax="100">
                                <span class="ds-progress-bar" style="--ds-progress-value:@(project.Percent)%"></span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</section>

@section Scripts {
    <script>
        (() => {
            document.querySelectorAll("[data-project-scope] input[type='radio']").forEach((input) => {
                input.addEventListener("change", () => input.form?.requestSubmit());
            });

            const root = document.querySelector("[data-project-list]");
            if (!root) return;

            const buttons = Array.from(root.querySelectorAll("[data-project-view-button]"));
            const panels = Array.from(root.querySelectorAll("[data-project-view-panel]"));

            buttons.forEach((button) => {
                button.addEventListener("click", () => {
                    const selected = button.dataset.projectViewButton;
                    buttons.forEach((candidate) => {
                        candidate.setAttribute("aria-checked", String(candidate === button));
                    });
                    panels.forEach((panel) => {
                        panel.hidden = panel.dataset.projectViewPanel !== selected;
                    });
                });
            });
        })();
    </script>
}
