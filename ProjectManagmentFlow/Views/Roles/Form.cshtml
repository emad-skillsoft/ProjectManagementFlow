@model RoleFormViewModel

@{
    ViewData["Title"] = Model.IsNew ? T["RoleForm_New"].Value : T["RoleForm_Edit", Model.Name].Value;
}

<section class="ds-permissions-page" style="max-inline-size: 40rem;">
    <header class="ds-permissions-page__header">
        <h1>@ViewData["Title"]</h1>
    </header>

    <form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <hr class="my-4" />
        <p class="text-muted small">@T["RoleForm_EnglishHint"]</p>

        <div class="mb-3">
            <label asp-for="NameEn" class="form-label"></label>
            <input asp-for="NameEn" class="form-control" dir="ltr" />
            <span asp-validation-for="NameEn" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DescriptionEn" class="form-label"></label>
            <textarea asp-for="DescriptionEn" class="form-control" rows="2" dir="ltr"></textarea>
            <span asp-validation-for="DescriptionEn" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">@T["Common_Save"]</button>
        <a class="btn btn-link" asp-action="Index">@T["Common_Cancel"]</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
