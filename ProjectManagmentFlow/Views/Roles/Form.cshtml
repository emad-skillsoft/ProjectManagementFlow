@model RoleFormViewModel

@{
    ViewData["Title"] = Model.IsNew ? "دور جديد" : $"تعديل الدور: {Model.Name}";
}

<div class="container" style="max-width: 560px; direction: rtl;">
    <h3 class="mb-4">@ViewData["Title"]</h3>

    <form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">حفظ</button>
        <a class="btn btn-link" asp-action="Index">إلغاء</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
