@model PermissionsPageViewModel
@inject ProjectManagmentFlow.Services.Permissions.IPermissionService PermissionService

@{
    ViewData["Title"] = T["Perm_PageTitle"].Value;
    var canCreate = PermissionService.HasPermission(ProjectManagmentFlow.Authorization.PermissionNames.RolesCreate);
    var canEdit   = PermissionService.HasPermission(ProjectManagmentFlow.Authorization.PermissionNames.RolesEdit);
    var canDelete = PermissionService.HasPermission(ProjectManagmentFlow.Authorization.PermissionNames.RolesDelete);
}

<section class="ds-permissions-page">
    <header class="ds-permissions-page__header">
        <h1>@T["Perm_PageTitle"]</h1>
        <p>@T["Perm_PageDescription"]</p>
    </header>

    <partial name="_StatusMessage" />

    <section aria-label="@T["Roles_Defined"]">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="ds-permissions-page__subtitle mb-0">@T["Roles_Defined"]</h2>
            @if (canCreate)
            {
                <a class="btn btn-primary" asp-action="Create">@T["Roles_New"]</a>
            }
        </div>

        @if (Model.Roles.Count == 0)
        {
            <p class="text-muted">@T["Roles_Empty"]</p>
        }
        else
        {
            <div class="ds-preset-role-grid">
                @foreach (var role in Model.Roles)
                {
                    <article class="ds-preset-role-card @(role.IsSelected ? "is-selected" : null)">
                        <header>
                            <h2>
                                <a class="stretched-link" asp-action="Index" asp-route-roleId="@role.Id">@role.Name</a>
                            </h2>
                            <span class="ds-preset-role-card__readonly @(role.IsSystem ? "is-builtin" : "is-custom")">
                                @(role.IsSystem ? T["Roles_BuiltIn"] : T["Roles_Custom"])
                            </span>
                        </header>
                        <p>@role.Description</p>
                        <footer>
                            <span>@T["Roles_HoldersLabel", role.MemberCount] · @T["Roles_GrantsLabel", role.PermissionCount]</span>
                            <span class="d-flex gap-2">
                                @if (role.IsSelected)
                                {
                                    <span class="ds-preset-role-card__state">@T["Roles_EditNow"]</span>
                                }
                                @if (canEdit && !role.IsSystem)
                                {
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Edit" asp-route-id="@role.Id">@T["Roles_Rename"]</a>
                                }
                                @if (canDelete && !role.IsSystem)
                                {
                                    <form asp-action="Delete" asp-route-id="@role.Id" method="post"
                                          onsubmit="return confirm('@T["Roles_DeleteConfirm", role.Name]');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@T["Common_Delete"]</button>
                                    </form>
                                }
                            </span>
                        </footer>
                    </article>
                }
            </div>
        }
    </section>

    @if (Model.Selected is { } selected)
    {
        @if (!canEdit)
        {
            <div class="alert alert-secondary ds-alert-accent mt-3" role="status">
                <span aria-hidden="true">ⓘ</span><span>@T["RolePerms_ReadOnly"]</span>
            </div>
        }

        <form asp-action="Permissions" asp-route-id="@selected.RoleId" method="post" data-permission-form>
            <div class="ds-permission-workspace">
                <partial name="_PermissionMatrix" model="selected.Matrix" />
                <partial name="_RolePanel" model="selected.Panel" />
            </div>
        </form>
    }
</section>
