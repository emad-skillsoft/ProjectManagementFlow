@model List<RoleListItemViewModel>
@inject ProjectManagmentFlow.Services.Permissions.IPermissionService PermissionService

@{
    ViewData["Title"] = "الأدوار";
    var canManage = PermissionService.HasPermission(ProjectManagmentFlow.Authorization.PermissionNames.RolesManage);
}

<div style="direction: rtl;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">الأدوار</h3>
        @if (canManage)
        {
            <a class="btn btn-primary" asp-action="Create">دور جديد</a>
        }
    </div>

    <partial name="_StatusMessage" />

    @if (Model.Count == 0)
    {
        <p class="text-muted">لا توجد أدوار بعد.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>الوصف</th>
                    <th>الصلاحيات</th>
                    <th>الأعضاء</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td class="fw-semibold">@role.Name</td>
                        <td class="text-muted">@role.Description</td>
                        <td>@role.PermissionCount</td>
                        <td>@role.MemberCount</td>
                        <td class="text-start">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Permissions" asp-route-id="@role.Id">الصلاحيات</a>
                            @if (canManage)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@role.Id">تعديل</a>
                                <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('حذف الدور @role.Name؟ سيفقد أعضاؤه صلاحياته فوراً.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
