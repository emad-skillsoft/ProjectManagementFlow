@model RolePermissionsViewModel
@inject ProjectManagmentFlow.Services.Permissions.IPermissionService PermissionService

@{
    ViewData["Title"] = T["RolePerms_Title", Model.RoleName].Value;
    var canManage = PermissionService.HasPermission(ProjectManagmentFlow.Authorization.PermissionNames.RolesManage);
}

<div>
    <h3 class="mb-3">@ViewData["Title"]</h3>

    <partial name="_StatusMessage" />

    @if (!canManage)
    {
        <div class="alert alert-secondary">@T["RolePerms_ReadOnly"]</div>
    }

    <form asp-action="Permissions" asp-route-id="@Model.RoleId" method="post">
        <div class="list-group mb-3">
            @foreach (var permission in Model.Permissions)
            {
                <label class="list-group-item d-flex gap-3 align-items-start">
                    <input class="form-check-input mt-1" type="checkbox" name="SelectedPermissionIds"
                           value="@permission.Id" checked="@permission.IsGranted" disabled="@(!canManage)" />
                    <span>
                        <span class="fw-semibold" dir="ltr">@permission.Name</span>
                        <span class="d-block text-muted small">@permission.Description</span>
                    </span>
                </label>
            }
        </div>

        @if (canManage)
        {
            <button type="submit" class="btn btn-primary">@T["RolePerms_Save"]</button>
        }
        <a class="btn btn-link" asp-action="Index">@T["Common_Back"]</a>
    </form>
</div>
