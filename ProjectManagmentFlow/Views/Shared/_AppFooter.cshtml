@model AppFooterViewModel

<footer class="dga-app-footer">
    <div class="dga-layout-container dga-app-footer__inner">
        <div class="dga-app-footer__meta">
            @if (!string.IsNullOrWhiteSpace(Model.LastUpdatedText))
            {
                <span>@Model.LastUpdatedText</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CopyrightText))
            {
                <span>@Model.CopyrightText</span>
            }
        </div>
    </div>
</footer>
