@model NewTaskFormViewModel
@{
    var filter = Context.Request.Query["filter"].ToString();
}

@*
    «مهمة جديدة» بوجهين: مهمّة فريقٍ تتبع مشروعاً، ومهمّة شخصية بلا مشروع.
    الوجهان نموذجٌ واحد لا نموذجان، لأنّ الحقول مشتركة إلّا ثلاثة؛ وما يُقفل
    منها في الوجه الشخصيّ يُقفل بـ disabled فلا يُرسَل أصلاً.
*@
<div class="modal fade" id="new-task" tabindex="-1" aria-labelledby="new-task-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ds-modal--task">
        <div class="modal-content">
            <form method="post" action="/Tasks/create" data-new-task>
                @Html.AntiForgeryToken()
                <input type="hidden" name="filter" value="@filter" />

                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="new-task-title">@T["MyTasks_NewTask"]</h2>
                    <button class="btn-close" type="button" data-bs-dismiss="modal"
                            aria-label="@T["Common_Close"]"></button>
                </div>

                <div class="modal-body d-grid gap-3">
                    <fieldset>
                        <legend class="ds-visually-clipped">@T["NewTask_TypeLabel"]</legend>
                        <div class="ds-segmented" role="radiogroup" aria-label="@T["NewTask_TypeLabel"]">
                            <input class="btn-check" id="kind-project" type="radio" name="kind" value="project"
                                   checked="@Model.HasProjects" disabled="@(!Model.HasProjects)" />
                            <label class="ds-segmented-button" for="kind-project">@T["NewTask_TeamTask"]</label>

                            <input class="btn-check" id="kind-personal" type="radio" name="kind" value="personal"
                                   checked="@(!Model.HasProjects)" />
                            <label class="ds-segmented-button" for="kind-personal">@T["NewTask_PersonalTask"]</label>
                        </div>
                        <p class="form-text mb-0" data-kind-hint
                           data-project-hint="@T["NewTask_TeamHint"]"
                           data-personal-hint="@T["NewTask_PersonalHint"]">
                            @(Model.HasProjects ? T["NewTask_TeamHint"].Value : T["NewTask_PersonalHint"].Value)
                        </p>
                        @if (!Model.HasProjects)
                        {
                            <p class="form-text mb-0">@T["NewTask_NoProjects"]</p>
                        }
                    </fieldset>

                    <div>
                        <label class="form-label fw-semibold" for="nt-title">
                            @T["NewTask_TitleLabel"] <span class="text-danger" aria-hidden="true">*</span>
                        </label>
                        <input class="form-control" id="nt-title" name="title" type="text" required
                               maxlength="200" autocomplete="off" placeholder="@T["NewTask_TitlePlaceholder"]" />
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold" for="nt-project">@T["NewTask_Project"]</label>
                            <select class="ds-select" id="nt-project" name="projectId" data-project-field
                                    disabled="@(!Model.HasProjects)">
                                @if (!Model.HasProjects)
                                {
                                    <option value="">@T["NewTask_NoProjectsShort"]</option>
                                }
                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                            <p class="form-text mb-0" data-personal-note hidden>@T["NewTask_PersonalHasNoProject"]</p>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold" for="nt-assignee">@T["TaskForm_Assignee"]</label>
                            <select class="ds-select" id="nt-assignee" name="assigneeId" data-project-field
                                    disabled="@(!Model.HasProjects)">
                                @* خياران بلا قيمة: أحدهما لوجه الفريق والآخر للشخصيّ. *@
                                <option value="" data-team-option>@T["TaskDetail_Unassigned"]</option>
                                <option value="" data-personal-option>@Model.ActorName</option>
                                @foreach (var project in Model.Projects)
                                {
                                    <optgroup label="@project.Name" data-project="@project.Id">
                                        @foreach (var person in project.Members)
                                        {
                                            <option value="@person.Id" data-project="@project.Id">@person.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <p class="form-text mb-0" data-assignee-hint
                               data-project-hint="@T["NewTask_AssigneeHint"]"
                               data-personal-hint="@T["NewTask_AssignedToYou"]">@T["NewTask_AssigneeHint"]</p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <fieldset class="ds-visibility-switch">
                                <legend class="ds-visibility-switch__label">
                                    @T["NewTask_Visibility"]
                                    <span class="badge ds-visibility-switch__lock" data-visibility-lock hidden>
                                        @T["NewTask_VisibilityLocked"]
                                    </span>
                                </legend>
                                <div class="ds-segmented ds-segmented--compact" role="radiogroup"
                                     aria-label="@T["NewTask_Visibility"]">
                                    @foreach (var option in Model.Visibilities)
                                    {
                                        <input class="btn-check" id="vis-@option.Value" type="radio" data-visibility
                                               name="visibility" value="@option.Value" checked="@option.IsSelected"
                                               disabled="@(!Model.HasProjects)" />
                                        <label class="ds-segmented-button" for="vis-@option.Value">@option.Label</label>
                                    }
                                </div>
                                <span class="ds-visibility-switch__hint" data-visibility-hint
                                      data-project-hint="@T["NewTask_VisibilityHint"]"
                                      data-personal-hint="@T["NewTask_VisibilityLockedHint"]">@T["NewTask_VisibilityHint"]</span>
                            </fieldset>
                        </div>
                        <div class="col-12 col-sm-6">
                            <fieldset class="ds-visibility-switch">
                                <legend class="ds-visibility-switch__label">@T["TaskForm_Priority"]</legend>
                                <div class="ds-segmented ds-segmented--compact" role="radiogroup"
                                     aria-label="@T["TaskForm_Priority"]">
                                    @foreach (var option in Model.Priorities)
                                    {
                                        <input class="btn-check" id="pri-@option.Value" type="radio"
                                               name="priority" value="@option.Value" checked="@option.IsSelected" />
                                        <label class="ds-segmented-button" for="pri-@option.Value">@option.Label</label>
                                    }
                                </div>
                            </fieldset>
                        </div>
                    </div>

                    <div>
                        <label class="form-label fw-semibold" for="nt-due">@T["TaskForm_Due"]</label>
                        <input class="form-control" id="nt-due" name="dueDate" type="date" style="max-inline-size: 16rem;" />
                    </div>

                    <div>
                        <label class="form-label fw-semibold" for="nt-desc">@T["TaskForm_Description"]</label>
                        <textarea class="form-control" id="nt-desc" name="description" rows="3"
                                  maxlength="4000" placeholder="@T["NewTask_DescriptionPlaceholder"]"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-primary" type="submit">@T["TaskForm_Submit"]</button>
                    <button class="btn btn-link" type="button" data-bs-dismiss="modal">@T["Common_Cancel"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
