@model ProjectManagmentFlow.ViewModels.ProjectCardViewModel

<a class="ds-project-card" href="@Model.Href">
    <div class="ds-project-card__top">
        <div class="ds-project-card__badges">
            <bdi class="ds-project-card__code ds-bidi-isolate" dir="ltr">@Model.Code</bdi>
            <span class="badge @Model.StatusBadgeClass d-inline-flex align-items-center gap-1">
                <span class="@Model.StatusClass" aria-hidden="true"></span>@Model.StatusLabel
            </span>
        </div>
        <span class="@Model.PriorityClass">@Model.PriorityLabel</span>
    </div>

    <h3 class="ds-project-card__title">@Model.Name</h3>

    <div class="ds-project-card__unit">
        <span>@Model.UnitName</span>
        <partial name="_UnitTypeBadge" model="new UnitTypeBadgeViewModel
        {
            Label = Model.UnitTypeLabel,
            IsRoot = Model.UnitIsRoot
        }" />
    </div>

    <div class="ds-project-card__owner">
        <span class="ds-avatar ds-avatar-sm" aria-hidden="true">@Model.OwnerInitial</span>
        <span class="ds-project-card__owner-name">
            <span class="visually-hidden">@T["Projects_OwnerNamed", Model.OwnerName]</span>
            <span aria-hidden="true">@Model.OwnerName</span>
        </span>
    </div>

    <div class="ds-project-card__due">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M16 3v4M8 3v4M3 10h18"></path>
        </svg>
        <span>@Model.DueLabel</span>
    </div>

    <div class="mt-auto">
        <div class="ds-project-card__progress-label">
            <span>@T["Projects_TasksDone"]</span>
            <bdi class="ds-bidi-isolate" dir="ltr">@Model.ProgressLabel</bdi>
        </div>
        <div class="ds-progress" role="progressbar" aria-label="@T["Projects_Progress"]"
             aria-valuenow="@Model.Percent" aria-valuemin="0" aria-valuemax="100">
            <span class="ds-progress-bar" style="--ds-progress-value:@(Model.Percent)%"></span>
        </div>
    </div>
</a>
