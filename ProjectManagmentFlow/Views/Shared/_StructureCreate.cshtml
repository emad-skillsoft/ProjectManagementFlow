@model ProjectManagmentFlow.ViewModels.StructureCreateDialogViewModel

<div class="modal fade" id="structure-create" tabindex="-1" aria-labelledby="structure-create-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="/Structure/units">
                @Html.AntiForgeryToken()
                <input type="hidden" name="parentId" value="@Model.ParentId" />
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="structure-create-title">@Model.Label</h2>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="@T["Common_Close"]"></button>
                </div>
                <div class="modal-body d-grid gap-3">
                    <div>
                        <label class="form-label fw-semibold" for="new-unit-name">@Model.NameLabel</label>
                        <input class="form-control" id="new-unit-name" name="name" required maxlength="200" autocomplete="off" />
                    </div>
                    <div>
                        <label class="form-label fw-semibold" for="new-unit-code">@Model.CodeLabel</label>
                        <input class="form-control" id="new-unit-code" name="code" maxlength="64" autocomplete="off" />
                    </div>
                    <div>
                        <label class="form-label fw-semibold" for="new-unit-type">@Model.TypeLabel</label>
                        <select class="ds-select" id="new-unit-type" name="type">
                            @foreach (var type in Model.AllowedTypes)
                            {
                                <option value="@type.Value" selected="@(type.IsSelected ? "" : null)">@type.Label</option>
                            }
                        </select>
                        <p class="form-text mb-0">@T["Structure_TypeHint"]</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">@T["Common_Cancel"]</button>
                    <button class="btn btn-primary" type="submit">@Model.SubmitLabel</button>
                </div>
            </form>
        </div>
    </div>
</div>
