@model ProjectManagmentFlow.ViewModels.StructureDeleteDialogViewModel

<div class="modal fade" id="structure-delete" tabindex="-1" aria-labelledby="structure-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="structure-delete-title">@Model.Label</h2>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="@T["Common_Close"]"></button>
            </div>
            <div class="modal-body d-grid gap-3">
                <p class="mb-0">@Model.ConfirmLabel</p>
                @if (Model.IsBlocked)
                {
                    <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
                        <span aria-hidden="true">ⓘ</span>
                        <span>@Model.Blocker</span>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">@T["Common_Cancel"]</button>
                @if (Model.IsBlocked)
                {
                    <button class="btn btn-danger" type="button" disabled title="@Model.Blocker">@T["Structure_DeleteSubmit"]</button>
                }
                else
                {
                    <form method="post" action="/Structure/units/@Model.UnitId/delete" class="d-inline-flex">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-danger" type="submit">@T["Structure_DeleteSubmit"]</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
