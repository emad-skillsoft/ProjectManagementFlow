@model ProjectManagmentFlow.ViewModels.StructureUnitPanelViewModel

<div class="tab-pane fade show active" role="tabpanel">
    <div class="ds-stats-grid d-grid gap-3">
        @foreach (var stat in Model.Stats)
        {
            <article class="ds-stat-card @stat.CssClass">
                <strong class="ds-stat-card__value">@stat.Value</strong>
                <span class="ds-stat-card__label">@stat.Label</span>
            </article>
        }
    </div>

    <section class="ds-org-structure__section" aria-label="@T["Structure_DirectChildrenCount", Model.DirectChildren]">
        <h2 class="ds-unit-header__title">@T["Structure_DirectUnitsHeading"]</h2>
        @if (Model.DirectUnits.Count == 0)
        {
            <p class="text-muted">@T["Structure_NoDirectUnits"]</p>
        }
        else
        {
            <div class="ds-unit-picker" role="list">
                @foreach (var unit in Model.DirectUnits)
                {
                    <a class="ds-unit-picker__row" role="listitem" href="@unit.Href">
                        <span class="ds-unit-picker__name">@unit.Name</span>
                        <partial name="_UnitTypeBadge" model="unit.Type" />
                        <span class="ds-unit-picker__summary">@T["Structure_DirectProjectsCount", unit.DirectProjects]</span>
                    </a>
                }
            </div>
        }
    </section>
</div>
