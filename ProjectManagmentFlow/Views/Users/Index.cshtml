@model List<UserListItemViewModel>
@inject ProjectManagmentFlow.Services.Permissions.IPermissionService PermissionService

@{
    ViewData["Title"] = T["Users_Title"].Value;
    var canManage = PermissionService.HasPermission(ProjectManagmentFlow.Authorization.PermissionNames.UsersManage);
}

<div>
    <h3 class="mb-3">@T["Users_Title"]</h3>

    <partial name="_StatusMessage" />

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>@T["Users_Name"]</th>
                <th>@T["Users_Email"]</th>
                <th>@T["Users_Roles"]</th>
                <th>@T["Users_Status"]</th>
                <th>@T["Users_LastSeen"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="fw-semibold">@user.DisplayName</td>
                    <td dir="ltr">@user.Email</td>
                    <td>
                        @if (user.Roles.Count == 0)
                        {
                            <span class="text-muted">@T["Users_NoRole"]</span>
                        }
                        else
                        {
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge text-bg-secondary">@role</span>
                            }
                        }
                    </td>
                    <td>
                        @if (!user.IsActive)
                        {
                            <span class="badge text-bg-danger">@T["Users_Disabled"]</span>
                        }
                        else if (user.IsLockedOut)
                        {
                            <span class="badge text-bg-warning">@T["Users_LockedOut"]</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">@T["Users_Active"]</span>
                        }
                    </td>
                    <td class="text-muted small" dir="ltr">
                        @(user.LastSeenAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                    </td>
                    <td class="text-end">
                        @if (canManage)
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Roles" asp-route-id="@user.Id">@T["Users_ManageRoles"]</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
