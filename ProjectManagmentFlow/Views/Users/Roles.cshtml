@model UserRolesViewModel

@{
    ViewData["Title"] = $"أدوار: {Model.DisplayName}";
}

<div style="direction: rtl;">
    <h3 class="mb-1">@ViewData["Title"]</h3>
    <p class="text-muted" dir="ltr">@Model.Email</p>

    <partial name="_StatusMessage" />

    @if (Model.IsSelf)
    {
        <div class="alert alert-warning">
            هذا حسابك. لا يمكنك تعديل أدوارك بنفسك حتّى لا تحبس نفسك خارج النظام.
        </div>
    }

    <form asp-action="Roles" asp-route-id="@Model.UserId" method="post">
        <div class="list-group mb-3">
            @foreach (var role in Model.Roles)
            {
                <label class="list-group-item d-flex gap-3 align-items-start">
                    <input class="form-check-input mt-1" type="checkbox" name="SelectedRoleIds"
                           value="@role.Id" checked="@role.IsAssigned" disabled="@Model.IsSelf" />
                    <span>
                        <span class="fw-semibold">@role.Name</span>
                        <span class="d-block text-muted small">@role.Description</span>
                    </span>
                </label>
            }
        </div>

        @if (!Model.IsSelf)
        {
            <button type="submit" class="btn btn-primary">حفظ الأدوار</button>
        }
        <a class="btn btn-link" asp-action="Index">رجوع</a>
    </form>
</div>
